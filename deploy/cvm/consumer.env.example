# Copy to consumer.env on the CVM. This file contains configuration only;
# mount every secret as a separate read-only file under /run/secrets. Before
# start, chown host files to 10001:10001 and chmod them 0400 (or 0600).
# Image tags are intentionally not stored here: export matching full
# 40-character release Git SHAs before using deploy/cvm/stack-safe.sh.
ZAOSHI_CONTROL_PLANE_TRANSPORT=private-docker
ZAOSHI_CONTROL_PLANE_URL=http://zaoshi-web:3000/
ZAOSHI_CONSUMER_WORKER_ID=cvm-primary-1
ZAOSHI_CONSUMER_KEY_ID=cvm-primary-2026-09
ZAOSHI_CONSUMER_AUDIENCE=zaoshi-cvm-private
ZAOSHI_CONSUMER_SECRET_FILE=/run/secrets/consumer-hmac

ZAOSHI_SPOOL_ROOT=/var/lib/zaoshi/spool
# Create this host directory as 10001:10001 mode 0700 before startup. It only
# contains the bounded, secret-free consumer health snapshot read by the Web.
ZAOSHI_HEALTH_FILE=/var/lib/zaoshi/consumer-health/health.json
ZAOSHI_SEEDREAM_SLOT_ID=seedream-primary
ZAOSHI_SEEDREAM_API_KEY_FILE=/run/secrets/seedream-api-key
ZAOSHI_QWEN_SLOT_ID=qwen-primary
ZAOSHI_QWEN_API_KEY_FILE=/run/secrets/qwen-api-key
ZAOSHI_QWEN_WORKSPACE_ID=replace-with-workspace-id

ZAOSHI_PROVIDER_TIMEOUT_MS=120000
ZAOSHI_HEARTBEAT_INTERVAL_MS=8000
ZAOSHI_IDLE_BACKOFF_MIN_MS=1000
ZAOSHI_IDLE_BACKOFF_MAX_MS=15000
ZAOSHI_ERROR_BACKOFF_MIN_MS=2000
ZAOSHI_ERROR_BACKOFF_MAX_MS=30000
ZAOSHI_RECONCILIATION_BACKOFF_MS=30000
ZAOSHI_SWEEP_INTERVAL_MS=60000
ZAOSHI_BUSY_BURST_LIMIT=8
ZAOSHI_QUARANTINE_RETENTION_DAYS=7
ZAOSHI_QUARANTINE_MAX_ENTRIES=100
ZAOSHI_QUARANTINE_MAX_BYTES=1073741824

# Optional private image relay: official provider keys remain on AWS.
# Configure only after restricted SSH/socket and private-test expiry are verified.
# ZAOSHI_OPENAI_GATEWAY_KEY_FILE=/run/secrets/openai-gateway-key
# ZAOSHI_GOOGLE_GATEWAY_KEY_FILE=/run/secrets/google-gateway-key

# cn-production + AUTH_MODE=email uses three independent consumer slots.
# Review owner/provider queue concurrency explicitly on the Web service.
