# Private SSH-tunnel test profile. Do not expose this anonymous mode publicly.
BACKEND_PROFILE=sites-demo
TRUST_PLATFORM_IDENTITY_HEADERS=0
GALLERY_ADMIN_EMAILS=
GENERATION_INTERNAL_API_ENABLED=0
# The internal API remains hidden until zero-cost preflight passes. When it is
# enabled on the single-host private stack, secrets come only from mounted files.
GENERATION_INTERNAL_TRANSPORT=private-docker
GENERATION_INTERNAL_AUDIENCE=zaoshi-cvm-private
GENERATION_INTERNAL_CURRENT_KEY_ID=cvm-primary-2026-09
GENERATION_INTERNAL_CURRENT_SECRET_FILE=/run/secrets/consumer-hmac
GENERATION_INTERNAL_TICKET_SECRET_FILE=/run/secrets/queue-ticket
GENERATION_INTERNAL_TICKET_TTL_SECONDS=240
GENERATION_QUEUE_LEASE_SECONDS=180
GENERATION_QUEUE_OWNER_CONCURRENCY=3
GENERATION_QUEUE_PROVIDER_CONCURRENCY=3
GENERATION_QUEUE_SWEEP_LIMIT=50
ZAOSHI_LIFECYCLE_MAINTENANCE_ENABLED=1
ZAOSHI_LIFECYCLE_INTERVAL_SECONDS=3600
