+func TestZaoshiCandidateValidationDoesNotBindSelectedAccount(t *testing.T) {
+	for _, order := range [][]string{{AccountTypeAPIKey, AccountTypeOAuth}, {AccountTypeOAuth, AccountTypeAPIKey}} {
+		t.Run(strings.Join(order, "-"), func(t *testing.T) {
+			ctx := WithZaoshiImageBudget(context.Background(), "gpt-image-2", time.Now(), nil)
+			b := ZaoshiImageBudgetFromContext(ctx)
+			b.GroupID = 8
+			repo := &zaoshiMixedAccountRepo{}
+			for i, kind := range order {
+				a := directImagesTestAccount()
+				a.ID = int64(10 + i)
+				a.Type = kind
+				a.GroupIDs = []int64{8}
+				require.NoError(t, b.ValidateAccount(a, b.Model))
+				repo.accounts = append(repo.accounts, *a)
+			}
+			gateway := newOpenAIImagesTestService(nil)
+			gateway.accountRepo = repo
+			accounts, err := gateway.listSchedulableAccounts(ctx, &b.GroupID, PlatformOpenAI)
+			require.NoError(t, err)
+			require.Len(t, accounts, 2)
+			require.Nil(t, b.account.Load())
+			require.NoError(t, b.BindAccount(&accounts[1], b.Model))
+			require.Equal(t, accounts[1].ID, b.account.Load().id)
+		})
+	}
+}
