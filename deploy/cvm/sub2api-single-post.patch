new file mode 100644
index 0000000..468cca0
--- /dev/null
+++ b/backend/internal/handler/zaoshi_image_guard.go
@@ -0,0 +1,47 @@
+package handler
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"regexp"
+	"time"
+
+	"github.com/Wei-Shaw/sub2api/internal/pkg/ctxkey"
+	"github.com/Wei-Shaw/sub2api/internal/pkg/logger"
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/gin-gonic/gin"
+	"go.uber.org/zap"
+)
+
+var zaoshiAttemptID = regexp.MustCompile(`^attempt_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$`)
+
+func zaoshiImageContext(c *gin.Context, model string, started time.Time, groupID *int64) (context.Context, error) {
+	if groupID == nil || *groupID <= 0 {
+		return nil, errors.New("Grouped image gateway key required")
+	}
+	id := c.GetHeader("X-Request-ID")
+	if !zaoshiAttemptID.MatchString(id) {
+		return nil, errors.New("Internal image attempt ID required")
+	}
+	ctx := context.WithValue(c.Request.Context(), ctxkey.ClientRequestID, id)
+	ctx = service.WithZaoshiImageBudget(ctx, model, started, func(providerID string) { c.Header(service.ZaoshiProviderRequestIDHeader, providerID) })
+	service.ZaoshiImageBudgetFromContext(ctx).GroupID = *groupID
+	service.ZaoshiImageBudgetFromContext(ctx).OnResponseHeaders = func(status int, header http.Header) {
+		c.Header("Content-Type", "application/json")
+		c.Status(status)
+		c.Writer.Flush()
+	}
+	return ctx, nil
+}
+
+// A bounded terminal audit line survives LOG_LEVEL=error, including body
+// failures without a usage row. It never records request/response payloads.
+func recordZaoshiImageTerminal(c *gin.Context, started time.Time) {
+	budget := service.ZaoshiImageBudgetFromContext(c.Request.Context())
+	if budget == nil {
+		return
+	}
+	id, _ := c.Request.Context().Value(ctxkey.ClientRequestID).(string)
+	logger.L().Error("zaoshi.image_terminal", zap.String("attempt_id", id), zap.String("provider_request_id", budget.ProviderRequestID()), zap.Bool("budget_claimed", budget.Sent()), zap.String("body_outcome", budget.BodyOutcome()), zap.Int("http_status", c.Writer.Status()), zap.Int64("duration_ms", time.Since(started).Milliseconds()))
+}
