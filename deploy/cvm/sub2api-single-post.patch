diff --git a/backend/internal/service/zaoshi_image_budget.go b/backend/internal/service/zaoshi_image_budget.go
new file mode 100644
index 0000000..71f845d
--- /dev/null
+++ b/backend/internal/service/zaoshi_image_budget.go
@@ -0,0 +1,218 @@
+package service
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"net/http"
+	"strings"
+	"sync/atomic"
+	"time"
+)
+
+const ZaoshiProviderRequestIDHeader = "X-Zaoshi-Provider-Request-Id"
+
+type zaoshiImageBudgetKey struct{}
+
+type zaoshiImageAccountBinding struct {
+	id   int64
+	kind string
+}
+
+// One object survives account selection, request clones and WithoutCancel.
+type ZaoshiImageBudget struct {
+	Model             string
+	Platform          string
+	Deadline          time.Time
+	GroupID           int64
+	account           atomic.Pointer[zaoshiImageAccountBinding] // immutable selected account
+	sent              atomic.Bool
+	bodyComplete      atomic.Bool
+	providerID        atomic.Value
+	captureID         func(string)
+	OnResponseHeaders func(int, http.Header)
+}
+
+func ZaoshiImagePlatform(model string) string {
+	switch model {
+	case "gpt-image-2.5-sunburst", "gpt-image-2.5-flare", "gpt-image-2":
+		return PlatformOpenAI
+	case "gemini-3.1-flash-lite-image", "gemini-3.1-flash-image", "gemini-3-pro-image":
+		return PlatformGemini
+	}
+	return ""
+}
+
+func ZaoshiImageModelVariant(model string) bool {
+	if ZaoshiImagePlatform(model) != "" {
+		return false
+	}
+	for _, candidate := range groupModelAllowlistCandidates(model) {
+		if ZaoshiImagePlatform(candidate) != "" {
+			return true
+		}
+	}
+	return false
+}
+
+func WithZaoshiImageBudget(ctx context.Context, model string, started time.Time, capture func(string)) context.Context {
+	deadline := started.Add(300 * time.Second)
+	if existing, ok := ctx.Deadline(); ok && existing.Before(deadline) {
+		deadline = existing
+	}
+	return context.WithValue(ctx, zaoshiImageBudgetKey{}, &ZaoshiImageBudget{Model: model, Platform: ZaoshiImagePlatform(model), Deadline: deadline, captureID: capture})
+}
+
+func ZaoshiImageBudgetFromContext(ctx context.Context) *ZaoshiImageBudget {
+	budget, _ := ctx.Value(zaoshiImageBudgetKey{}).(*ZaoshiImageBudget)
+	return budget
+}
+
+func CopyZaoshiImageBudget(parent, target context.Context) context.Context {
+	if budget := ZaoshiImageBudgetFromContext(parent); budget != nil {
+		return context.WithValue(target, zaoshiImageBudgetKey{}, budget)
+	}
+	return target
+}
+
+func (b *ZaoshiImageBudget) Sent() bool { return b.sent.Load() }
+
+func (b *ZaoshiImageBudget) MarkResponseBodyComplete() { b.bodyComplete.Store(true) }
+func (b *ZaoshiImageBudget) BodyOutcome() string {
+	if !b.Sent() {
+		return "not_attempted"
+	}
+	if b.bodyComplete.Load() {
+		return "response_body_complete"
+	}
+	return "response_body_incomplete"
+}
+
+func (b *ZaoshiImageBudget) ValidateAccount(account *Account, model string) error {
+	if b.GroupID <= 0 || !openAIStickyAccountMatchesGroup(account, &b.GroupID) || account == nil || (account.Type != AccountTypeAPIKey && !(b.Platform == PlatformOpenAI && account.Type == AccountTypeOAuth)) || account.IsShadow() || account.IsOpenAIAgentIdentity() || account.Platform != b.Platform || model != b.Model || account.GetMappedModel(model) != model || account.ProxyID != nil || account.Proxy != nil || account.IsCustomBaseURLEnabled() || len(account.GetHeaderOverrides()) != 0 || account.GetOpenAIUserAgent() != "" {
+		return errors.New("zaoshi image request requires an unmodified official account")
+	}
+	base := strings.TrimRight(strings.TrimSpace(account.GetCredential("base_url")), "/")
+	if account.Type == AccountTypeOAuth {
+		if base != "" && base != "https://chatgpt.com" {
+			return errors.New("zaoshi image account origin forbidden")
+		}
+	} else if base != "" && ((b.Platform == PlatformOpenAI && base != "https://api.openai.com" && base != "https://api.openai.com/v1") || (b.Platform == PlatformGemini && base != "https://generativelanguage.googleapis.com")) {
+		return errors.New("zaoshi image account origin forbidden")
+	}
+	return nil
+}
+
+// Candidate validation is pure; bind only after an account has been selected.
+func (b *ZaoshiImageBudget) BindAccount(account *Account, model string) error {
+	if err := b.ValidateAccount(account, model); err != nil {
+		return err
+	}
+	if account.ID <= 0 {
+		return errors.New("zaoshi image selected account ID required")
+	}
+	selected := &zaoshiImageAccountBinding{id: account.ID, kind: account.Type}
+	if b.account.CompareAndSwap(nil, selected) {
+		return nil
+	}
+	bound := b.account.Load()
+	if *bound != *selected {
+		return errors.New("zaoshi image selected account changed")
+	}
+	return nil
+}
+
+func (b *ZaoshiImageBudget) Claim(req *http.Request, proxy string) error {
+	if req == nil || req.URL == nil || proxy != "" {
+		return errors.New("zaoshi image transport forbidden")
+	}
+	u := req.URL
+	valid := u.Scheme == "https" && u.User == nil && u.RawQuery == "" && u.Fragment == "" && u.RawPath == "" && req.Method == http.MethodPost && (u.Port() == "" || u.Port() == "443")
+	if b.Platform == PlatformOpenAI {
+		if selected := b.account.Load(); selected != nil && selected.kind == AccountTypeOAuth {
+			valid = valid && u.Hostname() == "chatgpt.com" && (u.Path == "/backend-api/codex/images/generations" || u.Path == "/backend-api/codex/images/edits")
+		} else {
+			valid = valid && u.Hostname() == "api.openai.com" && (u.Path == "/v1/images/generations" || u.Path == "/v1/images/edits")
+		}
+	} else {
+		valid = valid && b.Platform == PlatformGemini && u.Hostname() == "generativelanguage.googleapis.com" && u.Path == "/v1beta/models/"+b.Model+":generateContent"
+	}
+	if !valid || (req.Host != "" && req.Host != u.Host) {
+		return errors.New("zaoshi image origin or path forbidden")
+	}
+	if !time.Now().Before(b.Deadline) {
+		return context.DeadlineExceeded
+	}
+	if !b.sent.CompareAndSwap(false, true) {
+		return errors.New("zaoshi image upstream POST budget exhausted")
+	}
+	return nil
+}
+
+func (b *ZaoshiImageBudget) CaptureProviderID(header http.Header) {
+	id := strings.TrimSpace(header.Get("x-request-id"))
+	if id == "" && b.Platform == PlatformGemini {
+		id = strings.TrimSpace(header.Get("x-goog-request-id"))
+	}
+	if id != "" && len(id) <= 200 && !strings.ContainsAny(id, "\r\n") {
+		b.providerID.Store(id)
+		if b.captureID != nil {
+			b.captureID(id)
+		}
+	}
+}
+
+func (b *ZaoshiImageBudget) ObserveResponseHeaders(status int, header http.Header) {
+	b.CaptureProviderID(header)
+	if b.OnResponseHeaders != nil {
+		b.OnResponseHeaders(status, header)
+	}
+}
+
+func (b *ZaoshiImageBudget) ProviderRequestID() string {
+	id, _ := b.providerID.Load().(string)
+	return id
+}
+
+func zaoshiUsageUpstreamID(ctx context.Context, account *Account, headers http.Header, ws bool) *string {
+	if budget := ZaoshiImageBudgetFromContext(ctx); budget != nil {
+		if id := budget.ProviderRequestID(); id != "" {
+			if len(id) > 128 {
+				return nil
+			}
+			return &id
+		}
+		return nil
+	}
+	return usageUpstreamRequestIDPtr(account, headers, ws)
+}
+
+func zaoshiGoogleResponseID(body []byte) string {
+	var envelope struct {
+		ResponseID string `json:"responseId"`
+		Candidates []struct {
+			FinishReason string `json:"finishReason"`
+			Content      struct {
+				Parts []struct {
+					Thought    bool `json:"thought"`
+					InlineData *struct {
+						Data string `json:"data"`
+					} `json:"inlineData"`
+				} `json:"parts"`
+			} `json:"content"`
+		} `json:"candidates"`
+	}
+	if json.Unmarshal(body, &envelope) != nil || len(envelope.Candidates) != 1 || envelope.Candidates[0].FinishReason != "STOP" {
+		return ""
+	}
+	images := 0
+	for _, part := range envelope.Candidates[0].Content.Parts {
+		if !part.Thought && part.InlineData != nil && part.InlineData.Data != "" {
+			images++
+		}
+	}
+	if images != 1 {
+		return ""
+	}
+	return envelope.ResponseID
+}
