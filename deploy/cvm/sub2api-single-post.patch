+func TestZaoshiGeminiHandlerFailureAndCandidateLimit(t *testing.T) {
+	for _, candidateCount := range []int{1, 2} {
+		for _, status := range []int{429, 500} {
+			t.Run(http.StatusText(status)+string(rune('0'+candidateCount)), func(t *testing.T) {
+				gin.SetMode(gin.TestMode)
+
+				var posts atomic.Int32
+				server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+					posts.Add(1)
+					w.Header().Set("X-Request-ID", "real-google-id")
+					w.WriteHeader(status)
+					_, _ = w.Write([]byte(`{"error":{"message":"test failure"}}`))
+				}))
+				defer server.Close()
+				upstream := &zaoshiWireUpstream{endpoint: server.URL}
+				h, group := newZaoshiGeminiWireHandler(t, upstream)
+				groupID := group.ID
+				router := gin.New()
+				router.POST("/v1beta/models/*modelAction", func(c *gin.Context) {
+					c.Set(string(middleware2.ContextKeyAPIKey), &service.APIKey{ID: 9202, UserID: 9203, GroupID: &groupID, Group: group, Status: service.StatusActive, User: &service.User{ID: 9203, Concurrency: 10, Balance: 100}})
+					c.Set(string(middleware2.ContextKeyUser), middleware2.AuthSubject{UserID: 9203, Concurrency: 10})
+					h.GeminiV1BetaModels(c)
+				})
+				body := `{"contents":[{"parts":[{"text":"test"}]}],"generationConfig":{"candidateCount":` + string(rune('0'+candidateCount)) + `}}`
+				req := httptest.NewRequest("POST", "/v1beta/models/gemini-3-pro-image:generateContent", bytes.NewBufferString(body))
+				req = req.WithContext(context.WithValue(context.Background(), ctxkey.Group, group))
+				req.Header.Set("Content-Type", "application/json")
+				req.Header.Set("X-Request-ID", zaoshiTestAttempt)
+				rec := httptest.NewRecorder()
+				router.ServeHTTP(rec, req)
+				if candidateCount == 2 {
+					require.Equal(t, 400, rec.Code)
+					require.Zero(t, posts.Load())
