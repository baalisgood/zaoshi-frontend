+	require.NotEmpty(t, website)
+	for _, test := range []struct{ provider, scenario string }{
+		{"openai-oauth", "stalled"}, {"openai-oauth", "invalid"}, {"openai-oauth", "oversize"}, {"openai-oauth", "truncated"}, {"openai", "stalled"}, {"openai", "invalid"}, {"openai", "oversize"}, {"openai", "truncated"}, {"google", "stalled"},
