+func zaoshiOAuthFixture(t *testing.T, model, endpoint string) (*gin.Context, *httptest.ResponseRecorder, []byte, []byte) {
+	t.Helper()
+	var imageBody bytes.Buffer
+	require.NoError(t, jpeg.Encode(&imageBody, image.NewRGBA(image.Rect(0, 0, 2, 2)), nil))
+	var body []byte
+	c, rec := newOpenAIImagesTestContext(t, nil)
+	if endpoint == "/v1/images/edits" {
+		var b bytes.Buffer
+		writer := multipart.NewWriter(&b)
+		for k, v := range map[string]string{"model": model, "prompt": "preserve room", "n": "1", "size": "1024x1536", "quality": "high", "output_format": "jpeg", "response_format": "b64_json"} {
+			require.NoError(t, writer.WriteField(k, v))
+		}
+		part, err := writer.CreatePart(textproto.MIMEHeader{"Content-Disposition": {`form-data; name="image"; filename="room.jpg"`}, "Content-Type": {"image/jpeg"}})
+		require.NoError(t, err)
+		_, err = part.Write(imageBody.Bytes())
+		require.NoError(t, err)
+		require.NoError(t, writer.Close())
+		body = b.Bytes()
+		c.Request = httptest.NewRequest(http.MethodPost, endpoint, bytes.NewReader(body))
+		c.Request.Header.Set("Content-Type", writer.FormDataContentType())
+	} else {
+		body = []byte(fmt.Sprintf(`{"model":%q,"prompt":"preserve room","n":1,"size":"1024x1536","quality":"high","output_format":"jpeg","response_format":"b64_json"}`, model))
+		c.Request = httptest.NewRequest(http.MethodPost, endpoint, bytes.NewReader(body))
+		c.Request.Header.Set("Content-Type", "application/json")
+	}
+	ctx := WithZaoshiImageBudget(c.Request.Context(), model, time.Now(), nil)
+	ZaoshiImageBudgetFromContext(ctx).GroupID = 8
+	c.Request = c.Request.WithContext(ctx)
+	return c, rec, body, imageBody.Bytes()
+}
+
+func TestZaoshiOAuthNativeFieldsAndRealModel(t *testing.T) {
