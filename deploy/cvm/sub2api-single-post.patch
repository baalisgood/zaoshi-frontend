+				require.Equal(t, base64.StdEncoding.EncodeToString(jpg), gjson.GetBytes(rec.Body.Bytes(), "data.0.b64_json").String())
+			})
+		}
+	}
+}
+
+func TestZaoshiOAuthFailureNeverFallsBackOrRefreshes(t *testing.T) {
+	for _, scenario := range []string{"401", "404", "405", "429", "500", "disconnect", "partial", "invalid", "no-model", "missing-token", "expired-token", "wrong-origin", "deadline"} {
+		t.Run(scenario, func(t *testing.T) {
+			c, rec, body, _ := zaoshiOAuthFixture(t, "gpt-image-2", "/v1/images/generations")
+			calls := 0
+			upstream := &codexModelsHTTPUpstreamStub{do: func(req *http.Request, proxy string, _ int64, _ int) (*http.Response, error) {
+				calls++
+				if err := ZaoshiImageBudgetFromContext(req.Context()).Claim(req, proxy); err != nil {
+					return nil, err
+				}
+				if scenario == "disconnect" {
+					return nil, io.ErrUnexpectedEOF
+				}
+				response := &http.Response{StatusCode: 200, Header: http.Header{}, Body: io.NopCloser(strings.NewReader("not-json"))}
+				if scenario == "partial" {
+					response.Body = passthroughErrReadCloser{err: io.ErrUnexpectedEOF}
+				}
+				if scenario == "no-model" {
+					response.Body = io.NopCloser(strings.NewReader(`{"data":[{"b64_json":"aGVsbG8="}]}`))
+				}
+				var status int
+				if _, err := fmt.Sscan(scenario, &status); err == nil {
+					response.StatusCode = status
+					response.Body = io.NopCloser(strings.NewReader(`{"error":{"message":"rejected"}}`))
+				}
+				return response, nil
+			}}
+			svc := newOpenAIImagesTestService(upstream)
+			svc.openAITokenProvider = &OpenAITokenProvider{}
+			account := directImagesTestAccount()
+			account.GroupIDs = []int64{8}
+			if scenario == "expired-token" {
+				account.Credentials["expires_at"] = time.Now().Add(-time.Hour).Format(time.RFC3339)
+			}
+			if scenario == "missing-token" {
+				delete(account.Credentials, "access_token")
+			}
+			if scenario == "wrong-origin" {
+				account.Credentials["base_url"] = "https://api.openai.com"
+			}
+			if scenario == "deadline" {
+				ZaoshiImageBudgetFromContext(c.Request.Context()).Deadline = time.Now().Add(-time.Second)
+			}
+			parsed, err := svc.ParseOpenAIImagesRequest(c, body)
+			require.NoError(t, err)
+			_, err = svc.ForwardImages(c.Request.Context(), c, account, body, parsed, "")
+			if scenario == "no-model" {
+				require.NoError(t, err)
+				require.False(t, gjson.GetBytes(rec.Body.Bytes(), "data.0.model").Exists())
+			} else {
+				require.Error(t, err)
+			}
+			expected := 1
+			if scenario == "missing-token" || scenario == "expired-token" || scenario == "wrong-origin" {
+				expected = 0
+			}
+			require.Equal(t, expected, calls)
+			if scenario == "deadline" || expected == 0 {
+				require.False(t, ZaoshiImageBudgetFromContext(c.Request.Context()).Sent())
+			}
+		})
+	}
+}
