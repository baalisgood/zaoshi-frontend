+			}))
+			defer upstreamServer.Close()
+			upstream := &zaoshiWireUpstream{endpoint: upstreamServer.URL}
+			router := gin.New()
+			if provider == "google" {
+				h, group := newZaoshiGeminiWireHandler(t, upstream)
+				router.POST("/v1beta/models/*modelAction", func(c *gin.Context) {
+					c.Set(string(middleware.ContextKeyAPIKey), &service.APIKey{ID: 99, GroupID: &group.ID, Group: group, User: &service.User{ID: 100, Balance: 100, Concurrency: 10}})
+					c.Set(string(middleware.ContextKeyUser), middleware.AuthSubject{UserID: 100, Concurrency: 10})
+					c.Request = c.Request.WithContext(context.WithValue(c.Request.Context(), ctxkey.Group, group))
+					h.GeminiV1BetaModels(c)
