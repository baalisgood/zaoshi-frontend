+type zaoshiAccountRepo struct {
+	AccountRepository
+	group    int64
+	platform string
+	account  Account
+}
+
+func (r *zaoshiAccountRepo) ListSchedulableByGroupIDAndPlatform(_ context.Context, group int64, platform string) ([]Account, error) {
+	r.group = group
+	r.platform = platform
+	return []Account{r.account}, nil
+}
+func (r *zaoshiAccountRepo) GetByID(context.Context, int64) (*Account, error) { return &r.account, nil }
+
+func TestZaoshiImageGroupsAndAccountGuard(t *testing.T) {
+	for _, fixture := range []struct {
+		model    string
+		group    int64
+		platform string
+	}{{"gpt-image-2", 10, PlatformOpenAI}, {"gemini-3-pro-image", 20, PlatformGemini}} {
+		ctx := WithZaoshiImageBudget(context.Background(), fixture.model, time.Now(), nil)
+		budget := ZaoshiImageBudgetFromContext(ctx)
+		budget.GroupID = fixture.group
+		good := Account{ID: 1, Platform: fixture.platform, Type: AccountTypeAPIKey, GroupIDs: []int64{fixture.group}}
+		if err := budget.ValidateAccount(&good, fixture.model); err != nil {
+			t.Fatal(err)
+		}
+		repo := &zaoshiAccountRepo{account: good}
+		if fixture.platform == PlatformOpenAI {
+			gateway := &OpenAIGatewayService{accountRepo: repo, cfg: &config.Config{RunMode: config.RunModeSimple}}
+			accounts, err := gateway.listSchedulableAccounts(ctx, &fixture.group, fixture.platform)
+			if err != nil || len(accounts) != 1 {
+				t.Fatalf("group selection failed: %v", err)
+			}
+			repo.account.GroupIDs = []int64{999}
+			accounts, err = gateway.listSchedulableAccounts(ctx, &fixture.group, fixture.platform)
+			if err != nil || len(accounts) != 0 {
+				t.Fatal("foreign group selected")
+			}
+			if account, _ := gateway.getSchedulableAccount(ctx, 1); account != nil {
+				t.Fatal("foreign sticky selected")
+			}
+		} else {
+			gateway := &GatewayService{accountRepo: repo, cfg: &config.Config{RunMode: config.RunModeSimple}}
+			accounts, mixed, err := gateway.listSchedulableAccounts(ctx, &fixture.group, fixture.platform, false)
+			if err != nil || mixed || len(accounts) != 1 {
+				t.Fatalf("group selection failed: %v", err)
+			}
+			repo.account.GroupIDs = []int64{999}
+			accounts, _, err = gateway.listSchedulableAccounts(ctx, &fixture.group, fixture.platform, false)
+			if err != nil || len(accounts) != 0 {
+				t.Fatal("foreign group selected")
+			}
+			if account, _ := gateway.getSchedulableAccount(ctx, 1); account != nil {
+				t.Fatal("foreign sticky selected")
+			}
+		}
+		if repo.group != fixture.group || repo.platform != fixture.platform {
+			t.Fatal("exact group/platform query bypassed")
+		}
+		for _, mutate := range []func(*Account){func(a *Account) { a.Type = AccountTypeSetupToken }, func(a *Account) { a.Platform = PlatformAntigravity }, func(a *Account) { a.GroupIDs = nil }, func(a *Account) { p := int64(3); a.ProxyID = &p }, func(a *Account) { a.Credentials = map[string]any{"base_url": "https://evil.example"} }, func(a *Account) {
+			a.Credentials = map[string]any{"model_mapping": map[string]any{fixture.model: "rewritten"}}
+		}} {
+			bad := good
+			mutate(&bad)
+			if budget.ValidateAccount(&bad, fixture.model) == nil {
+				t.Fatal("unsafe account accepted")
+			}
+		}
+	}
+}
+
+func TestZaoshiUsageProviderIDIsExactAndCopied(t *testing.T) {
+	ctx := WithZaoshiImageBudget(context.Background(), "gpt-image-2", time.Now(), nil)
+	budget := ZaoshiImageBudgetFromContext(ctx)
+	for _, id := range []string{"actual-provider", strings.Repeat("x", 128), strings.Repeat("x", 129)} {
+		budget.CaptureProviderID(http.Header{"X-Request-Id": []string{id}})
+		target := CopyZaoshiImageBudget(ctx, context.Background())
+		if ZaoshiImageBudgetFromContext(target) != budget {
+			t.Fatal("budget copy lost identity")
+		}
+		got := zaoshiUsageUpstreamID(target, nil, nil, false)
+		if len(id) > 128 {
+			if got != nil {
+				t.Fatal("provider ID was truncated")
+			}
+		} else if got == nil || *got != id {
+			t.Fatal("provider ID lost")
+		}
+	}
+}
+
+func TestZaoshiGoogleResponseIDRequiresSuccessfulImageEnvelope(t *testing.T) {
+	for _, body := range []string{`{"responseId":"false-id","error":{}}`, `{"responseId":"false-id","candidates":[]}`, `{"responseId":"false-id","candidates":[{"finishReason":"MAX_TOKENS"}]}`, `{"id":"arbitrary","candidates":[{"finishReason":"STOP","content":{"parts":[{"inlineData":{"data":"AA=="}}]}}]}`} {
+		if zaoshiGoogleResponseID([]byte(body)) != "" {
+			t.Fatal("invalid envelope ID trusted")
+		}
+	}
+	if id := zaoshiGoogleResponseID([]byte(`{"responseId":"actual","candidates":[{"finishReason":"STOP","content":{"parts":[{"inlineData":{"data":"AA=="}}]}}]}`)); id != "actual" {
+		t.Fatal("actual ID lost")
+	}
+}
+
+func TestZaoshiRejectsAllowlistVariantsOnly(t *testing.T) {
+	for _, model := range []string{"GEMINI-3-PRO-IMAGE", "gemini-3-pro-image-thinking", "GPT-IMAGE-2", "gpt-image-2-thinking", "models/gemini-3.1-flash-image"} {
+		if !ZaoshiImageModelVariant(model) {
+			t.Fatalf("variant missed: %s", model)
+		}
+	}
+	for _, model := range []string{"gpt-image-2", "gemini-3-pro-image", "gemini-2.5-flash", "claude-sonnet-thinking"} {
+		if ZaoshiImageModelVariant(model) {
+			t.Fatalf("unrelated/exact model changed: %s", model)
+		}
+	}
+}
