+func TestZaoshiSelectedAccountCannotChangeBeforeOrAfterSend(t *testing.T) {
+	for _, change := range []string{"id", "type"} {
+		t.Run(change, func(t *testing.T) {
+			c, _, body, _ := zaoshiOAuthFixture(t, "gpt-image-2", "/v1/images/generations")
+			calls := 0
+			upstream := &codexModelsHTTPUpstreamStub{do: func(req *http.Request, proxy string, _ int64, _ int) (*http.Response, error) {
+				calls++
+				require.NoError(t, ZaoshiImageBudgetFromContext(req.Context()).Claim(req, proxy))
+				return openAIImagesJSONResponse(), nil
+			}}
+			svc := newOpenAIImagesTestService(upstream)
+			svc.openAITokenProvider = &OpenAITokenProvider{}
+			a := directImagesTestAccount()
+			a.GroupIDs = []int64{8}
+			b := ZaoshiImageBudgetFromContext(c.Request.Context())
+			require.NoError(t, b.BindAccount(a, b.Model))
+			other := *a
+			if change == "id" {
+				other.ID++
+			} else {
+				other.Type = AccountTypeAPIKey
+			}
+			// Candidate filtering remains pure even after selection, but packet dispatch cannot switch.
+			require.NoError(t, b.ValidateAccount(&other, b.Model))
+			require.Error(t, b.BindAccount(&other, b.Model))
+			req, err := http.NewRequestWithContext(c.Request.Context(), http.MethodPost, "https://chatgpt.com/backend-api/codex/images/generations", strings.NewReader("{}"))
+			require.NoError(t, err)
+			_, err = svc.doOpenAIUpstream(req, "", &other)
+			require.Error(t, err)
+			require.Zero(t, calls)
+			require.False(t, b.Sent())
+			parsed, err := svc.ParseOpenAIImagesRequest(c, body)
+			require.NoError(t, err)
+			_, err = svc.ForwardImages(c.Request.Context(), c, a, body, parsed, "")
+			require.NoError(t, err)
+			require.Equal(t, 1, calls)
+			_, err = svc.ForwardImages(c.Request.Context(), c, &other, body, parsed, "")
+			require.Error(t, err)
+			require.Equal(t, 1, calls)
+		})
+	}
