+			defer os.RemoveAll(directory)
+			socket := filepath.Join(directory, "gateway.sock")
+			listener, err := net.Listen("unix", socket)
+			require.NoError(t, err)
+			gateway := &http.Server{Handler: router}
+			go func() { _ = gateway.Serve(listener) }()
+			defer gateway.Close()
+			script := `import {request} from 'node:http';
+import {createSub2ApiTransport} from './lib/consumer/sub2api-fetch.ts';
+import {prepareOverseasSingleImageGeneration} from './lib/ai/index.ts';
+const inspect=async p=>({mode:p.endsWith('.sock')?0o600:0o700,uid:10001,isSocket:()=>p.endsWith('.sock'),isDirectory:()=>!p.endsWith('.sock'),isSymbolicLink:()=>false});
+const routed=(options,cb)=>request({...options,socketPath:process.env.ZAOSHI_TEST_SOCKET},cb);
+const transport=createSub2ApiTransport({requestTimeoutMs:300,privateTestExpiresAt:Math.floor(Date.now()/1000)+60},{request:routed,lstat:inspect,effectiveUid:10001});
+const work={workflowType:'self-service',purpose:'final',resolution:'1K',aspectRatio:'1:1',quality:'auto',style:{presetId:'self-service'},lighting:{timeOfDay:'day',lampState:'off',colorTemperatureKelvin:4000},renovationScope:'restyle',customPrompt:'test',outputCount:1,providerPreference:process.env.ZAOSHI_TEST_PROVIDER==='google'?'gemini-3-pro-image':'gpt-image-2'};
+const prepared=prepareOverseasSingleImageGeneration(work,{env:{BACKEND_PROFILE:'cn-production',OPENAI_API_KEY:'fake-gateway',GOOGLE_API_KEY:'fake-gateway'},fetch:(input,init)=>{const headers=new Headers(init.headers);headers.set('X-Request-ID','attempt_12345678-1234-1234-1234-123456789012');return transport.fetch(input,{...init,headers})}});
+try{await prepared.execute();console.error('unexpected success');process.exit(1)}catch(e){if(e.providerRequestId!=='actual-chain-id'){console.error('lost provider id',e.providerRequestId);process.exit(2)}console.log('known-id failure retained')}`
+			cmd := exec.CommandContext(context.Background(), "node", "--import", "tsx", "--input-type=module", "-e", script)
+			cmd.Dir = website
+			cmd.Env = append(os.Environ(), "ZAOSHI_TEST_SOCKET="+socket, "ZAOSHI_TEST_PROVIDER="+provider)
+			output, err := cmd.CombinedOutput()
+			require.NoError(t, err, string(output))
+			require.Contains(t, string(output), "known-id failure retained")
+			require.Equal(t, int32(1), posts.Load())
+		})
+	}
