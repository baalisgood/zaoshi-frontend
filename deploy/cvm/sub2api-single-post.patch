+type zaoshiGeminiRepo struct {
+	openAIImagesFailoverAccountRepo
+}
+
+func (zaoshiGeminiRepo) SetRateLimited(context.Context, int64, time.Time) error { return nil }
+func (zaoshiGeminiRepo) SetOverloaded(context.Context, int64, time.Time) error  { return nil }
+func (zaoshiGeminiRepo) SetModelRateLimit(context.Context, int64, string, time.Time, ...string) error {
+	return nil
+}
+
+type zaoshiWireUpstream struct {
+	service.HTTPUpstream
+	endpoint string
+	calls    atomic.Int32
+	budget   *service.ZaoshiImageBudget
+}
+
+func (u *zaoshiWireUpstream) Do(req *http.Request, proxy string, _ int64, _ int) (*http.Response, error) {
+	u.calls.Add(1)
+	budget := service.ZaoshiImageBudgetFromContext(req.Context())
+	if u.budget != nil && u.budget != budget {
+		panic("budget recreated")
+	}
+	u.budget = budget
+	if err := budget.Claim(req, proxy); err != nil {
+		return nil, err
+	}
+	routed := req.Clone(req.Context())
+	routed.URL, _ = url.Parse(u.endpoint)
+	routed.Host = ""
+	routed.GetBody = nil
+	routed.Close = true
+	resp, err := http.DefaultClient.Do(routed)
+	if err == nil {
+		budget.ObserveResponseHeaders(resp.StatusCode, resp.Header)
+	}
+	return resp, err
+}
