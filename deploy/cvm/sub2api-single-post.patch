new file mode 100644
index 0000000..1bb6c16
--- /dev/null
+++ b/backend/internal/repository/zaoshi_image_transport.go
@@ -0,0 +1,73 @@
+package repository
+
+import (
+	"context"
+	"crypto/tls"
+	"errors"
+	"io"
+	"net"
+	"net/http"
+	"time"
+
+	"github.com/Wei-Shaw/sub2api/internal/service"
+)
+
+func zaoshiImageTransport() *http.Transport {
+	return &http.Transport{
+		DialContext:       (&net.Dialer{Timeout: 10 * time.Second}).DialContext,
+		TLSClientConfig:   &tls.Config{MinVersion: tls.VersionTLS12, NextProtos: []string{"http/1.1"}},
+		TLSNextProto:      map[string]func(string, *tls.Conn) http.RoundTripper{},
+		ForceAttemptHTTP2: false, DisableKeepAlives: true, DisableCompression: true,
+		TLSHandshakeTimeout: 10 * time.Second, ResponseHeaderTimeout: 300 * time.Second,
+		MaxResponseHeaderBytes: 16 << 10,
+	}
+}
+
+func doZaoshiImageRequest(req *http.Request, proxy string, transport *http.Transport) (*http.Response, error) {
+	budget := service.ZaoshiImageBudgetFromContext(req.Context())
+	if err := budget.Claim(req, proxy); err != nil {
+		return nil, err
+	}
+	// WithoutCancel intentionally detaches client disconnects; restore the same
+	// absolute deadline here, and retain it until the response body is closed.
+	ctx, cancel := context.WithDeadline(req.Context(), budget.Deadline)
+	request := req.Clone(ctx)
+	request.GetBody = nil
+	request.Close = true
+	client := &http.Client{Transport: transport, CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }}
+	resp, err := doUpstreamRequest(client, request)
+	if err != nil {
+		cancel()
+		transport.CloseIdleConnections()
+		return nil, err
+	}
+	resp.Body = &cancelOnCloseBody{ReadCloser: resp.Body, cancel: func() { cancel(); transport.CloseIdleConnections() }}
+	limit := int64(12 << 20)
+	if resp.StatusCode >= 400 {
+		limit = 64 << 10
+	}
+	resp.Body = &zaoshiBoundedBody{ReadCloser: resp.Body, remaining: limit, onComplete: budget.MarkResponseBodyComplete}
+	return resp, nil
+}
+
+type zaoshiBoundedBody struct {
+	io.ReadCloser
+	remaining  int64
+	onComplete func()
+}
+
+func (b *zaoshiBoundedBody) Read(p []byte) (int, error) {
+	if int64(len(p)) > b.remaining+1 {
+		p = p[:b.remaining+1]
+	}
+	n, err := b.ReadCloser.Read(p)
+	if int64(n) > b.remaining {
+		_ = b.ReadCloser.Close()
+		return 0, errors.New("zaoshi image response exceeds bounded limit")
+	}
+	b.remaining -= int64(n)
+	if err == io.EOF && b.onComplete != nil {
+		b.onComplete()
+	}
+	return n, err
+}
