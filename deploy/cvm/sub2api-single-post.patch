+	}
+}
+
+func TestZaoshiImageConcurrentRequestsShareOneWireBudget(t *testing.T) {
+	var posts atomic.Int32
+	server, pool := zaoshiTLSFixture(t, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { posts.Add(1); _, _ = w.Write([]byte("{}")) }))
+	ctx := service.WithZaoshiImageBudget(context.Background(), "gpt-image-2", time.Now(), nil)
+	var completed atomic.Int32
+	var workers sync.WaitGroup
+	for i := 0; i < 10; i++ {
+		workers.Add(1)
+		go func() {
+			defer workers.Done()
+			req, _ := http.NewRequestWithContext(ctx, "POST", "https://api.openai.com/v1/images/generations", strings.NewReader("{}"))
+			tr := zaoshiImageTransport()
+			tr.TLSClientConfig.RootCAs = pool
+			tr.DialContext = func(ctx context.Context, network, address string) (net.Conn, error) {
+				return (&net.Dialer{}).DialContext(ctx, network, server.Listener.Addr().String())
+			}
+			if resp, err := doZaoshiImageRequest(req, "", tr); err == nil {
+				_, _ = io.ReadAll(resp.Body)
+				_ = resp.Body.Close()
+				completed.Add(1)
+			}
+		}()
+	}
+	workers.Wait()
+	if posts.Load() != 1 || completed.Load() != 1 {
+		t.Fatalf("posts=%d completed=%d", posts.Load(), completed.Load())
+	}
+}
+
+// Decoder initialization may read the body; provider headers must be observed
+// first even when that encoded body never arrives.
+func TestZaoshiCompressedHeadersObservedBeforeBodyRead(t *testing.T) {
+	for _, encoding := range []string{"gzip", "zstd"} {
+		t.Run(encoding, func(t *testing.T) {
+			var posts atomic.Int32
+			upstreamHeaders := make(chan struct{})
+			server, pool := zaoshiTLSFixture(t, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				posts.Add(1)
+				_, _ = io.Copy(io.Discard, r.Body)
+				w.Header().Set("X-Request-ID", "actual-compressed-id")
+				w.Header().Set("Content-Encoding", encoding)
+				w.WriteHeader(200)
+				w.(http.Flusher).Flush()
+				close(upstreamHeaders)
+				<-r.Context().Done()
+			}))
+			ctx := service.WithZaoshiImageBudget(context.Background(), "gpt-image-2", time.Now(), nil)
+			budget := service.ZaoshiImageBudgetFromContext(ctx)
+			budget.Deadline = time.Now().Add(time.Second)
+			observed := make(chan struct{}, 2)
+			var observations atomic.Int32
+			budget.OnResponseHeaders = func(status int, headers http.Header) {
+				observations.Add(1)
+				if status != 200 || headers.Get("X-Request-ID") != "actual-compressed-id" {
+					t.Error("actual status/provider headers changed")
+				}
+				observed <- struct{}{}
+			}
+			tr := zaoshiImageTransport()
+			tr.TLSClientConfig.RootCAs = pool
+			tr.DialContext = func(ctx context.Context, _, _ string) (net.Conn, error) {
+				return (&net.Dialer{}).DialContext(ctx, "tcp", server.Listener.Addr().String())
+			}
+			req, _ := http.NewRequestWithContext(ctx, "POST", "https://api.openai.com/v1/images/generations", strings.NewReader(`{}`))
+			finished := make(chan struct{})
+			go func() {
+				resp, _ := doZaoshiImageRequest(req, "", tr)
+				if resp != nil {
+					_ = resp.Body.Close()
+				}
+				close(finished)
+			}()
+			<-upstreamHeaders
+			select {
+			case <-observed:
+			case <-time.After(250 * time.Millisecond):
+				t.Error("provider headers delayed behind compressed body read")
+			}
+			<-finished
+			if observations.Load() != 1 || budget.ProviderRequestID() != "actual-compressed-id" || posts.Load() != 1 {
+				t.Fatalf("observations=%d providerID=%q wirePOSTs=%d", observations.Load(), budget.ProviderRequestID(), posts.Load())
+			}
+		})
+	}
+}
