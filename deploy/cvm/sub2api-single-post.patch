+func TestZaoshiAccountOriginIsBoundToCredentialType(t *testing.T) {
+	for _, kind := range []string{AccountTypeAPIKey, AccountTypeOAuth} {
+		for _, host := range []string{"api.openai.com", "chatgpt.com"} {
+			ctx := WithZaoshiImageBudget(context.Background(), "gpt-image-2", time.Now(), nil)
+			b := ZaoshiImageBudgetFromContext(ctx)
+			b.GroupID = 8
+			account := directImagesTestAccount()
+			account.Type = kind
+			account.GroupIDs = []int64{8}
+			require.NoError(t, b.BindAccount(account, b.Model))
+			path := "/v1/images/edits"
+			if host == "chatgpt.com" {
+				path = "/backend-api/codex/images/edits"
+			}
+			req, err := http.NewRequest(http.MethodPost, "https://"+host+path, nil)
+			require.NoError(t, err)
+			err = b.Claim(req, "")
+			if (kind == AccountTypeOAuth) == (host == "chatgpt.com") {
+				require.NoError(t, err)
+			} else {
+				require.Error(t, err)
+				require.False(t, b.Sent())
+			}
+		}
+	}
+	for _, mutate := range []func(*Account){func(a *Account) { a.Type = AccountTypeSetupToken }, func(a *Account) { id := int64(9); a.ParentAccountID = &id }, func(a *Account) { a.Credentials["base_url"] = "https://api.openai.com" }} {
+		ctx := WithZaoshiImageBudget(context.Background(), "gpt-image-2", time.Now(), nil)
+		b := ZaoshiImageBudgetFromContext(ctx)
+		b.GroupID = 8
+		a := directImagesTestAccount()
+		a.GroupIDs = []int64{8}
+		mutate(a)
+		require.Error(t, b.ValidateAccount(a, b.Model))
+	}
