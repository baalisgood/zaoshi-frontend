+func TestZaoshiImageRejectsBeforeWire(t *testing.T) {
+	for _, url := range []string{"http://api.openai.com/v1/images/generations", "https://evil.example/v1/images/generations", "https://api.openai.com/v1/responses", "https://api.openai.com/v1/images/generations?x=1"} {
