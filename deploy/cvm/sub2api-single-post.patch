+				req, _ := http.NewRequestWithContext(ctx, "POST", path, strings.NewReader("{}"))
+				tr := zaoshiImageTransport()
+				tr.TLSClientConfig.RootCAs = pool
+				tr.DialContext = func(ctx context.Context, network, address string) (net.Conn, error) {
+					return (&net.Dialer{}).DialContext(ctx, network, server.Listener.Addr().String())
+				}
+				if tr.ForceAttemptHTTP2 || !tr.DisableKeepAlives || tr.Proxy != nil || tr.TLSClientConfig.InsecureSkipVerify {
+					t.Fatal("unsafe production transport")
+				}
+				resp, err := doZaoshiImageRequest(req, "", tr)
+				if scenario == "disconnect" {
+					if err == nil {
+						t.Fatal("expected disconnect")
+					}
+				} else {
+					if err != nil {
+						t.Fatal(err)
+					}
+					_, readErr := io.ReadAll(resp.Body)
+					_ = resp.Body.Close()
+					if (scenario == "stalled-body" || scenario == "large-success" || scenario == "large-error") && readErr == nil {
+						t.Fatal("body deadline not enforced")
+					}
+					if id != "actual-upstream" {
+						t.Fatalf("lost provider id %q", id)
+					}
+				}
+				if _, err := doZaoshiImageRequest(req.Clone(ctx), "", tr); err == nil {
+					t.Fatal("second send allowed")
+				}
+				if posts.Load() != 1 || protocol.Load() != 1 {
+					t.Fatalf("wire posts=%d HTTP=%d", posts.Load(), protocol.Load())
+				}
+			})
+		}
+	}
+}
