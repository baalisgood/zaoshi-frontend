+					response := fmt.Sprintf(`{"data":[{"b64_json":%q,"model":"actual-provider-model","output_format":"jpeg"}]}`, base64.StdEncoding.EncodeToString(jpg))
+					budget.ObserveResponseHeaders(200, http.Header{"X-Request-Id": {"actual-provider-id"}})
+					return &http.Response{StatusCode: 200, Header: http.Header{"Content-Type": {"application/json"}}, Body: io.NopCloser(strings.NewReader(response))}, nil
