{
  "name": "zaoshi-ai-interior-studio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:cvm": "ZAOSHI_BUILD_TARGET=cvm vinext build",
    "build:consumer": "vite build --config vite.consumer.config.ts",
    "build:acceptance": "vite build --config vite.acceptance.config.ts",
    "build:provider-canary": "vite build --config vite.provider-canary.config.ts",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs && npm run test:server && npm run test:ai",
    "test:ai": "tsx --test tests/ai/*.test.ts",
    "test:server": "tsx --test tests/server/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern dist-consumer --ignore-pattern dist-acceptance --ignore-pattern dist-provider-canary --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "env:domestic": "node scripts/configure-domestic-env.mjs",
    "smoke:domestic": "tsx --env-file=.env.local scripts/domestic-provider-smoke.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "nodemailer": "10.0.13",
    "qrcode.react": "4.2.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.4",
    "svg-captcha": "1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@openai/sites-vite-plugin": "0.1.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "4.22.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
