# Safe default for local UI development. The real domestic providers remain disabled.
BACKEND_PROFILE=sites-demo
TRUST_PLATFORM_IDENTITY_HEADERS=0
GALLERY_ADMIN_EMAILS=
ADMIN_EMAILS=

# WeChat website QR login. Local development stays in demo mode. Production
# Node deployments must load all three secret values from 0400/0600 files.
AUTH_MODE=demo
WECHAT_OPEN_APP_ID=
WECHAT_OPEN_REDIRECT_URI=
WECHAT_OPEN_SECRET_FILE=
SESSION_SECRET_FILE=
AUTH_IDENTITY_PEPPER_FILE=

# One-time domestic provider smoke test only. Copy the needed values to the
# ignored .env.local file and change BACKEND_PROFILE there to cn-production.
# Never commit real keys.
ARK_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=

# Optional prompt optimizer. The image generation endpoint is fixed in source.
ARK_PROMPT_MODEL=

# Durable queue control plane. Keep disabled until the CVM consumer, fenced
# output commit and crash-recovery tests are complete. Never commit real keys.
GENERATION_INTERNAL_API_ENABLED=0
GENERATION_INTERNAL_AUDIENCE=
GENERATION_INTERNAL_CURRENT_KEY_ID=
GENERATION_INTERNAL_CURRENT_SECRET=
GENERATION_INTERNAL_PREVIOUS_KEY_ID=
GENERATION_INTERNAL_PREVIOUS_SECRET=
GENERATION_INTERNAL_PREVIOUS_EXPIRES_AT=
# Sites-only signing secret for short-lived input/output tickets. Never copy
# this value to the CVM consumer; it is distinct from the machine HMAC secret.
GENERATION_INTERNAL_TICKET_SECRET=
GENERATION_INTERNAL_TICKET_TTL_SECONDS=240
GENERATION_QUEUE_LEASE_SECONDS=180
GENERATION_QUEUE_OWNER_CONCURRENCY=3
GENERATION_QUEUE_PROVIDER_CONCURRENCY=3
GENERATION_QUEUE_SWEEP_LIMIT=50

# CVM-only lifecycle maintenance. The current SQLite deployment permits one
# Web process under flock; keep this disabled for Sites and local UI demos.
ZAOSHI_LIFECYCLE_MAINTENANCE_ENABLED=0
ZAOSHI_LIFECYCLE_INTERVAL_SECONDS=3600
